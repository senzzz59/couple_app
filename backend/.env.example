# ===== 宝塔生产数据库：使用已创建的 couple，不创建新库 =====
# 填写 DB_PASSWORD；支持 MySQL 5.7.44 和 MySQL 8+。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=couple
DB_USER=couple
DB_PASSWORD=
# MYSQL_PASSWORD 仅用于 docker-compose.dev.yml 的本地测试数据库
MYSQL_PASSWORD=change-me-to-a-long-password
# 随机长字符串，用于签发登录令牌。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# ===== 邮件（注册 / 找回密码的验证码）=====
# 不填的话验证码只会打印在服务器日志里（适合本地开发）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# 465 用 true（SSL），587 用 false（STARTTLS）
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM="us. <noreply@example.com>"

# 最多允许注册几个账号（两个人用就是 2）
MAX_USERS=2
# 你们所在时区：决定时光胶囊“哪天”解锁
APP_TZ=Asia/Shanghai

# ===== 生产 Docker 和直接 npm start 都使用这个现有数据库 =====
# MySQL 连接串：mysql://用户:密码@主机:端口/数据库
# 可选：完整连接串；填写时优先于上面的 DB_* 参数
DATABASE_URL=
PORT=8787
HOST=127.0.0.1
# 照片存放目录
UPLOAD_DIR=./uploads

# Expo 增强推送安全开启时填写；未开启可留空
EXPO_ACCESS_TOKEN=
