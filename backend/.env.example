# ===== 宝塔生产数据库：使用已创建的 couple，不创建新库 =====
# 填写 DB_PASSWORD；支持 MySQL 5.7.44 和 MySQL 8+。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=couple
DB_USER=couple
DB_PASSWORD=
# MYSQL_PASSWORD 仅用于 docker-compose.dev.yml 的本地测试数据库
MYSQL_PASSWORD=change-me-to-a-long-password
# 随机长字符串，用于签发登录令牌。生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# ===== 邮件（注册 / 找回密码的验证码）=====
# 不填的话验证码只会打印在服务器日志里（适合本地开发）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# 465 用 true（SSL），587 用 false（STARTTLS）
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM="us. <noreply@example.com>"
# 自动部署完成后发通知邮件给谁（用上面的 SMTP 发）：留空 = 2110901906@qq.com；多个用逗号分开；填 off 关闭
DEPLOY_NOTIFY_EMAIL=

# 你们所在时区：决定时光胶囊“哪天”解锁
APP_TZ=Asia/Shanghai

# ===== 生产 Docker 和直接 npm start 都使用这个现有数据库 =====
# MySQL 连接串：mysql://用户:密码@主机:端口/数据库
# 可选：完整连接串；填写时优先于上面的 DB_* 参数
DATABASE_URL=
PORT=8787
HOST=127.0.0.1
# 照片存放目录
UPLOAD_DIR=./uploads

# Expo 增强推送安全开启时填写；未开启可留空
EXPO_ACCESS_TOKEN=

# 网页消息通知：留空即可，服务器会自动生成密钥并存进数据库
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 联系方式（mailto: 邮箱或 https:// 网址）；留空时用网站地址
VAPID_SUBJECT=

# 高德 Web服务 Key：实时店铺资料（评分、人均、照片）及路线耗时
# 建议后端配置；兼容已有前端 EXPO_PUBLIC_AMAP_KEY，前端 Key 仅作为后备
AMAP_WEB_SERVICE_KEY=

# ===== 对象存储（雨云 ROS 等 S3 兼容服务）：照片和视频放到对象存储，加载更快 =====
# 全部留空 = 继续只存服务器本地。填好后重启（或重新部署）后端：
# 新上传的文件处理完自动传上去；以前的本地文件会在后台逐个搬过去，校验大小一致后删除本地那份。
# 桶保持私有（不用开公共访问）：后端给浏览器跳转到 7 天有效的临时签名链接。
# API 端点（不是「访问地址」）
S3_ENDPOINT=
# 桶名
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 可选：服务器和桶在同一地域的雨云机器时填内网地址（不含桶名），上传走内网；连不通会自动改用公网
S3_INTERNAL_ENDPOINT=
# 可选：签名区域，一般不用改
S3_REGION=
# 可选：true 时用 端点/桶名/文件 的路径风格；默认 桶名.端点 的域名风格（和控制台「访问地址」一致）
S3_FORCE_PATH_STYLE=
# 可选：桶里的目录前缀，比如 couple
S3_PREFIX=
