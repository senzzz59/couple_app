# 复制为 .env.local 后修改
# 后端地址（登录页也可以手动填写）。本地开发填电脑的局域网 IP，如 http://192.168.1.6:8787
EXPO_PUBLIC_API_URL=

# EAS 项目 ID；用于独立 App 的在线更新和离线推送
EXPO_PUBLIC_EAS_PROJECT_ID=

# 可选：高德「Web服务」Key —— 已有配置继续兼容；新配置推荐后端 AMAP_WEB_SERVICE_KEY
EXPO_PUBLIC_AMAP_KEY=

# 可选：高德「Web端(JS API)」Key + 安全密钥 —— 足迹页显示真实地图
# 不填时足迹页显示“星座”视图（把去过的店连成星座）
EXPO_PUBLIC_AMAP_JS_KEY=
EXPO_PUBLIC_AMAP_JS_CODE=
